package fountain::f_util

import std.collection.ArrayList
import std.env.getVariable
import std.fs.{File, OpenMode}
import std.io.StringReader
import std.sync.Mutex

/**
 * x86_64 Linux 的 CRC-64 折叠核（`PCLMULQDQ`）。
 *
 * - 反射核：`PSHUFB` nibble 位反转 + `BSWAP` 做 64 位位反转，再走正常域折叠；
 * - 正常域核：只做 16 字节序反转。
 *
 * 字节由 `as --64` 汇编后 `objcopy` 提取，`objdump -D -b binary -m i386:x86-64` 逐条核对；
 * 新核已用独立 C 参考（XZ/ISO/REDIS/ECMA × 16..4096B）对拍，并在 WSL x86_64 的
 * `CrcEngine_test` 6 变体用例中验证。仍为静态字节数组，无运行时发射器。
 */
@When[os == "Linux" && arch == "x86_64"]
class Crc64Hw {
    private static let lock = Mutex()
    private static var ready = false
    /** `setNativeEnabled(false)` 立即生效，优先级高于环境变量。 */
    private static var forcedOff = false
    private static var modeResolved = false
    private static var modeState = CrcHwMode.Auto
    /** 最近一次 `update` 是否真的进了机器码（供三态用例断言）。 */
    private static var lastNative = false
    /** 测试钩子：模拟 `CodeBuffer` 分配/密封失败。 */
    private static var failAlloc = false
    private static var fn: ?CFunc<(UInt64, CPointer<Byte>, UInt64, CPointer<UInt64>) -> UInt64> = None
    private static var fnNorm: ?CFunc<(UInt64, CPointer<Byte>, UInt64, CPointer<UInt64>) -> UInt64> = None
    private static let codes = ArrayList<CodeBuffer>()
    private static var constsXz: ?Array<UInt64> = None
    private static var constsIso: ?Array<UInt64> = None
    private static var constsRedis: ?Array<UInt64> = None
    private static var constsNorm: ?Array<UInt64> = None

    /**
     * 反射核（495 字节，单块 16B 折叠）。
     *
     * 常量指针 rcx：0=P、8=x^128、16=x^192、24=mu、32=LUT、48=mask0F、64=maskF0、80=revIdx。
     * 入口 bitrev64(crc)；每块 bitrev + 16B 反序；折叠后 Barrett；出口 bitrev64。
     */
    private static let REF_CODE: Array<UInt8> = [
        0x48, 0x83, 0xfa, 0x10, 0x0f, 0x82, 0xbe, 0x02, 0x00, 0x00, 0xf3, 0x44,
        0x0f, 0x7e, 0x01, 0xf3, 0x44, 0x0f, 0x7e, 0x49, 0x08, 0xf3, 0x44, 0x0f,
        0x7e, 0x51, 0x10, 0xf3, 0x44, 0x0f, 0x7e, 0x59, 0x18, 0xf3, 0x44, 0x0f,
        0x6f, 0x61, 0x20, 0xf3, 0x44, 0x0f, 0x6f, 0x69, 0x30, 0xf3, 0x44, 0x0f,
        0x6f, 0x71, 0x40, 0xf3, 0x44, 0x0f, 0x6f, 0x79, 0x50, 0x66, 0x48, 0x0f,
        0x6e, 0xc7, 0x66, 0x0f, 0x6f, 0xc8, 0x66, 0x41, 0x0f, 0xdb, 0xcd, 0x66,
        0x0f, 0x71, 0xd0, 0x04, 0x66, 0x41, 0x0f, 0xdb, 0xc5, 0x66, 0x41, 0x0f,
        0x6f, 0xd4, 0x66, 0x0f, 0x38, 0x00, 0xd1, 0x66, 0x0f, 0x71, 0xf2, 0x04,
        0x66, 0x41, 0x0f, 0xdb, 0xd6, 0x66, 0x41, 0x0f, 0x6f, 0xdc, 0x66, 0x0f,
        0x38, 0x00, 0xd8, 0x66, 0x0f, 0xeb, 0xd3, 0x66, 0x48, 0x0f, 0x7e, 0xd0,
        0x48, 0x0f, 0xc8, 0x66, 0x48, 0x0f, 0x6e, 0xc0, 0x66, 0x0f, 0x6f, 0xf0,
        0xf3, 0x0f, 0x6f, 0x06, 0x48, 0x83, 0xc6, 0x10, 0x66, 0x0f, 0x6f, 0xc8,
        0x66, 0x41, 0x0f, 0xdb, 0xcd, 0x66, 0x0f, 0x71, 0xd0, 0x04, 0x66, 0x41,
        0x0f, 0xdb, 0xc5, 0x66, 0x41, 0x0f, 0x6f, 0xd4, 0x66, 0x0f, 0x38, 0x00,
        0xd1, 0x66, 0x0f, 0x71, 0xf2, 0x04, 0x66, 0x41, 0x0f, 0xdb, 0xd6, 0x66,
        0x41, 0x0f, 0x6f, 0xdc, 0x66, 0x0f, 0x38, 0x00, 0xd8, 0x66, 0x0f, 0xeb,
        0xd3, 0x66, 0x0f, 0x6f, 0xc2, 0x66, 0x41, 0x0f, 0x38, 0x00, 0xc7, 0x66,
        0x0f, 0x6f, 0xd6, 0x66, 0x41, 0x0f, 0x3a, 0x44, 0xd0, 0x00, 0x66, 0x0f,
        0xef, 0xc2, 0x66, 0x0f, 0x6f, 0xf0, 0x48, 0x83, 0xea, 0x10, 0x74, 0x6f,
        0xf3, 0x0f, 0x6f, 0x06, 0x48, 0x83, 0xc6, 0x10, 0x66, 0x0f, 0x6f, 0xc8,
        0x66, 0x41, 0x0f, 0xdb, 0xcd, 0x66, 0x0f, 0x71, 0xd0, 0x04, 0x66, 0x41,
        0x0f, 0xdb, 0xc5, 0x66, 0x41, 0x0f, 0x6f, 0xd4, 0x66, 0x0f, 0x38, 0x00,
        0xd1, 0x66, 0x0f, 0x71, 0xf2, 0x04, 0x66, 0x41, 0x0f, 0xdb, 0xd6, 0x66,
        0x41, 0x0f, 0x6f, 0xdc, 0x66, 0x0f, 0x38, 0x00, 0xd8, 0x66, 0x0f, 0xeb,
        0xd3, 0x66, 0x0f, 0x6f, 0xc2, 0x66, 0x41, 0x0f, 0x38, 0x00, 0xc7, 0x66,
        0x0f, 0x6f, 0xd6, 0x66, 0x41, 0x0f, 0x3a, 0x44, 0xd1, 0x00, 0x66, 0x0f,
        0x6f, 0xde, 0x66, 0x41, 0x0f, 0x3a, 0x44, 0xda, 0x01, 0x66, 0x0f, 0xef,
        0xd3, 0x66, 0x0f, 0xef, 0xc2, 0x66, 0x0f, 0x6f, 0xf0, 0x48, 0x83, 0xea,
        0x10, 0x75, 0x91, 0x66, 0x0f, 0x6f, 0xd6, 0x66, 0x41, 0x0f, 0x3a, 0x44,
        0xd0, 0x00, 0x66, 0x0f, 0x6f, 0xde, 0x66, 0x41, 0x0f, 0x3a, 0x44, 0xd9,
        0x01, 0x66, 0x0f, 0xef, 0xd3, 0x66, 0x0f, 0x6f, 0xda, 0x66, 0x0f, 0x73,
        0xdb, 0x08, 0x66, 0x0f, 0x6f, 0xe3, 0x66, 0x41, 0x0f, 0x3a, 0x44, 0xe3,
        0x00, 0x66, 0x0f, 0x73, 0xdc, 0x08, 0x66, 0x0f, 0xef, 0xe3, 0x66, 0x0f,
        0x6f, 0xec, 0x66, 0x41, 0x0f, 0x3a, 0x44, 0xe8, 0x00, 0x66, 0x48, 0x0f,
        0x7e, 0xd0, 0x66, 0x49, 0x0f, 0x7e, 0xe8, 0x4c, 0x31, 0xc0, 0x66, 0x48,
        0x0f, 0x6e, 0xc0, 0x66, 0x0f, 0x6f, 0xc8, 0x66, 0x41, 0x0f, 0xdb, 0xcd,
        0x66, 0x0f, 0x71, 0xd0, 0x04, 0x66, 0x41, 0x0f, 0xdb, 0xc5, 0x66, 0x41,
        0x0f, 0x6f, 0xd4, 0x66, 0x0f, 0x38, 0x00, 0xd1, 0x66, 0x0f, 0x71, 0xf2,
        0x04, 0x66, 0x41, 0x0f, 0xdb, 0xd6, 0x66, 0x41, 0x0f, 0x6f, 0xdc, 0x66,
        0x0f, 0x38, 0x00, 0xd8, 0x66, 0x0f, 0xeb, 0xd3, 0x66, 0x48, 0x0f, 0x7e,
        0xd0, 0x48, 0x0f, 0xc8, 0x66, 0x48, 0x0f, 0x6e, 0xc0, 0x66, 0x48, 0x0f,
        0x7e, 0xc0, 0xc3,
    ]

    /**
     * 正常域核（221 字节，单块 16B 折叠）。
     *
     * 只使用 0=P、8=x^128、16=x^192、24=mu 与偏移 32 的 revIdx；不做入口/出口位反转。
     */
    private static let NORM_CODE: Array<UInt8> = [
        0x48, 0x83, 0xfa, 0x10, 0x0f, 0x82, 0xcf, 0x00, 0x00, 0x00, 0xf3, 0x44,
        0x0f, 0x7e, 0x01, 0xf3, 0x44, 0x0f, 0x7e, 0x49, 0x08, 0xf3, 0x44, 0x0f,
        0x7e, 0x51, 0x10, 0xf3, 0x44, 0x0f, 0x7e, 0x59, 0x18, 0xf3, 0x44, 0x0f,
        0x6f, 0x79, 0x20, 0x66, 0x48, 0x0f, 0x6e, 0xf7, 0xf3, 0x0f, 0x6f, 0x06,
        0x48, 0x83, 0xc6, 0x10, 0x66, 0x41, 0x0f, 0x38, 0x00, 0xc7, 0x66, 0x0f,
        0x6f, 0xd6, 0x66, 0x41, 0x0f, 0x3a, 0x44, 0xd0, 0x00, 0x66, 0x0f, 0xef,
        0xc2, 0x66, 0x0f, 0x6f, 0xf0, 0x48, 0x83, 0xea, 0x10, 0x74, 0x36, 0xf3,
        0x0f, 0x6f, 0x06, 0x48, 0x83, 0xc6, 0x10, 0x66, 0x41, 0x0f, 0x38, 0x00,
        0xc7, 0x66, 0x0f, 0x6f, 0xd6, 0x66, 0x41, 0x0f, 0x3a, 0x44, 0xd1, 0x00,
        0x66, 0x0f, 0x6f, 0xde, 0x66, 0x41, 0x0f, 0x3a, 0x44, 0xda, 0x01, 0x66,
        0x0f, 0xef, 0xd3, 0x66, 0x0f, 0xef, 0xc2, 0x66, 0x0f, 0x6f, 0xf0, 0x48,
        0x83, 0xea, 0x10, 0x75, 0xca, 0x66, 0x0f, 0x6f, 0xd6, 0x66, 0x41, 0x0f,
        0x3a, 0x44, 0xd0, 0x00, 0x66, 0x0f, 0x6f, 0xde, 0x66, 0x41, 0x0f, 0x3a,
        0x44, 0xd9, 0x01, 0x66, 0x0f, 0xef, 0xd3, 0x66, 0x0f, 0x6f, 0xda, 0x66,
        0x0f, 0x73, 0xdb, 0x08, 0x66, 0x0f, 0x6f, 0xe3, 0x66, 0x41, 0x0f, 0x3a,
        0x44, 0xe3, 0x00, 0x66, 0x0f, 0x73, 0xdc, 0x08, 0x66, 0x0f, 0xef, 0xe3,
        0x66, 0x0f, 0x6f, 0xec, 0x66, 0x41, 0x0f, 0x3a, 0x44, 0xe8, 0x00, 0x66,
        0x48, 0x0f, 0x7e, 0xd0, 0x66, 0x49, 0x0f, 0x7e, 0xe8, 0x4c, 0x31, 0xc0,
        0xc3, 0x48, 0x89, 0xf8, 0xc3,
    ]

    static func supports(poly: UInt64): Bool {
        poly == 0x42F0E1EBA9EA3693u64 || poly == 0x1Bu64 || poly == 0xAD93D23594C935A9u64
    }

    static func supportsNormal(poly: UInt64): Bool {
        poly == 0x42F0E1EBA9EA3693u64
    }

    static func available(): Bool {
        if (isOff()) {
            return false
        }
        ensureReady()
        fn.isSome() || fnNorm.isSome()
    }

    static func update(crc: UInt64, data: Array<Byte>, aligned: Int64, poly: UInt64): ?UInt64 {
        lastNative = false
        if (isOff() || aligned < 16 || aligned > data.size || !supports(poly)) {
            return None
        }
        if (!ensureReady()) {
            return None
        }
        let selected = match (poly) {
            case 0x42F0E1EBA9EA3693u64 => constsXz
            case 0x1Bu64 => constsIso
            case _ => constsRedis
        }
        call(fn, selected, crc, data, aligned)
    }

    static func updateNormal(crc: UInt64, data: Array<Byte>, aligned: Int64): ?UInt64 {
        lastNative = false
        if (isOff() || aligned < 16 || aligned > data.size) {
            return None
        }
        if (!ensureReady()) {
            return None
        }
        call(fnNorm, constsNorm, crc, data, aligned)
    }

    private static func call(f: ?CFunc<(UInt64, CPointer<Byte>, UInt64, CPointer<UInt64>) -> UInt64>,
        c: ?Array<UInt64>, crc: UInt64, data: Array<Byte>, aligned: Int64): ?UInt64 {
        let result: ?UInt64 = match (f) {
            case Some(fn2) =>
                match (c) {
                    case Some(consts) =>
                        let handle = unsafe { acquireArrayRawData<Byte>(data) }
                        let chandle = unsafe { acquireArrayRawData<UInt64>(consts) }
                        try {
                            Some(unsafe { fn2(crc, handle.pointer, UInt64(aligned), chandle.pointer) })
                        } finally {
                            unsafe { releaseArrayRawData(handle) }
                            unsafe { releaseArrayRawData(chandle) }
                        }
                    case None => None
                }
            case None => None
        }
        lastNative = result.isSome()
        result
    }

    static func setNativeEnabled(value: Bool): Unit {
        forcedOff = !value
    }

    /** 最近一次 `update` 是否进了机器码。 */
    static func lastUsedNativeForTest(): Bool {
        lastNative
    }

    /** 当前解析出的模式名，供三态用例断言。 */
    static func modeNameForTest(): String {
        match (mode()) {
            case CrcHwMode.Off => "off"
            case CrcHwMode.On => "on"
            case CrcHwMode.Auto => "auto"
        }
    }

    /** 模拟 `CodeBuffer` 失败，验证回退。 */
    static func forceAllocFailureForTest(value: Bool): Unit {
        failAlloc = value
    }

    static func resetForTest(): Unit {
        synchronized(lock) {
            ready = false
            forcedOff = false
            modeResolved = false
            modeState = CrcHwMode.Auto
            lastNative = false
            failAlloc = false
            fn = None
            fnNorm = None
            constsXz = None
            constsIso = None
            constsRedis = None
            constsNorm = None
            codes.clear()
        }
    }

    private static func ensureReady(): Bool {
        synchronized(lock) {
            if (ready) {
                fn.isSome() || fnNorm.isSome()
            } else {
                ready = true
                if (isOff() || !hasPclmul()) {
                    false
                } else {
                    fn = make(REF_CODE)
                    fnNorm = make(NORM_CODE)
                    constsXz = CrcGf.reflectX86Constants(0x42F0E1EBA9EA3693u64, true)
                    constsIso = CrcGf.reflectX86Constants(0x1Bu64, true)
                    constsRedis = CrcGf.reflectX86Constants(0xAD93D23594C935A9u64, true)
                    constsNorm = CrcGf.reflectX86Constants(0x42F0E1EBA9EA3693u64, false)
                    fn.isSome() || fnNorm.isSome()
                }
            }
        }
    }

    private static func make(bytes: Array<UInt8>): ?CFunc<(UInt64, CPointer<Byte>, UInt64, CPointer<UInt64>) -> UInt64> {
        if (failAlloc) {
            return None
        }
        match (CodeBuffer.alloc(bytes.size + 64)) {
            case Some(buffer) =>
                if (!buffer.write(bytes, 0) || !buffer.seal()) {
                    None
                } else {
                    codes.add(buffer)
                    Some(CFunc<(UInt64, CPointer<Byte>, UInt64, CPointer<UInt64>) -> UInt64>(
                        CPointer<Unit>(buffer.rawPointer())))
                }
            case None => None
        }
    }

    private static func isOff(): Bool {
        match (mode()) {
            case CrcHwMode.Off => true
            case _ => false
        }
    }

    /** 三态模式：`off`/`0`、`on`/`1`、其它或未设 = `auto`；`forcedOff` 优先。 */
    private static func mode(): CrcHwMode {
        if (forcedOff) {
            return CrcHwMode.Off
        }
        if (!modeResolved) {
            modeState = parseMode()
            modeResolved = true
        }
        modeState
    }

    private static func parseMode(): CrcHwMode {
        match (getVariable("F_UTIL_CRC_HW")) {
            case Some(v) =>
                if (v == "0" || v == "off" || v == "OFF" || v == "Off") {
                    CrcHwMode.Off
                } else if (v == "1" || v == "on" || v == "ON" || v == "On") {
                    CrcHwMode.On
                } else {
                    CrcHwMode.Auto
                }
            case None => CrcHwMode.Auto
        }
    }

    private static func hasPclmul(): Bool {
        try {
            let f = File("/proc/cpuinfo", OpenMode.Read)
            let text = try {
                StringReader(f).readToEnd()
            } finally {
                f.close()
            }
            text.contains("pclmulqdq") && text.contains("ssse3")
        } catch (_: Exception) {
            false
        }
    }
}
