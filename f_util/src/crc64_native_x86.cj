package fountain::f_util

import std.collection.ArrayList
import std.env.getVariable
import std.fs.{File, OpenMode}
import std.io.StringReader
import std.sync.Mutex

/**
 * x86_64 Linux 的 CRC-64 折叠核（`PCLMULQDQ`）。
 *
 * - 反射核：`PSHUFB` nibble 位反转 + `BSWAP` 做 64 位位反转，再走正常域折叠；
 * - 正常域核：只做 16 字节序反转。
 *
 * 机器码由离线编码器生成，字节已用 `objdump -D -b binary -m i386:x86-64` 逐条核对；
 * **尚未在 x86 真机执行验证**，首次上 x86 时需跑 `CrcEngine_test` 的 6 变体对拍。
 */
@When[os == "Linux" && arch == "x86_64"]
class Crc64Hw {
    private static let lock = Mutex()
    private static var ready = false
    private static var nativeEnabled = true
    private static var fn: ?CFunc<(UInt64, CPointer<Byte>, UInt64, CPointer<UInt64>) -> UInt64> = None
    private static var fnNorm: ?CFunc<(UInt64, CPointer<Byte>, UInt64, CPointer<UInt64>) -> UInt64> = None
    private static let codes = ArrayList<CodeBuffer>()
    private static var constsXz: ?Array<UInt64> = None
    private static var constsIso: ?Array<UInt64> = None
    private static var constsRedis: ?Array<UInt64> = None
    private static var constsNorm: ?Array<UInt64> = None

    /** 反射核（539 字节）。 */
    private static let REF_CODE: Array<UInt8> = [
        0xf3, 0x0f, 0x6f, 0x61, 0x00, 0xf3, 0x0f, 0x6f, 0x69, 0x10, 0xf3, 0x0f, 0x6f, 0x71, 0x20, 0xf3,
        0x0f, 0x6f, 0x79, 0x30, 0xf3, 0x44, 0x0f, 0x6f, 0x41, 0x40, 0xf3, 0x44, 0x0f, 0x6f, 0x49, 0x50,
        0xf3, 0x44, 0x0f, 0x6f, 0x71, 0x60, 0xf3, 0x44, 0x0f, 0x6f, 0x51, 0x70, 0x66, 0x48, 0x0f, 0x6e,
        0xc7, 0x66, 0x44, 0x0f, 0x6f, 0xd8, 0x66, 0x45, 0x0f, 0xdb, 0xd9, 0x66, 0x44, 0x0f, 0x6f, 0xe0,
        0x66, 0x41, 0x0f, 0x71, 0xd4, 0x04, 0x66, 0x45, 0x0f, 0xdb, 0xe1, 0x66, 0x45, 0x0f, 0x6f, 0xe8,
        0x66, 0x45, 0x0f, 0x38, 0x00, 0xeb, 0x66, 0x41, 0x0f, 0x71, 0xf5, 0x04, 0x66, 0x45, 0x0f, 0xdb,
        0xee, 0x66, 0x45, 0x0f, 0x6f, 0xd8, 0x66, 0x45, 0x0f, 0x38, 0x00, 0xdc, 0x66, 0x45, 0x0f, 0xeb,
        0xeb, 0x66, 0x41, 0x0f, 0x6f, 0xc5, 0x66, 0x48, 0x0f, 0x7e, 0xc0, 0x48, 0x0f, 0xc8, 0x66, 0x48,
        0x0f, 0x6e, 0xc0, 0x66, 0x0f, 0xef, 0xc9, 0x66, 0x0f, 0x6c, 0xc1, 0xf3, 0x0f, 0x6f, 0x4e, 0x00,
        0x48, 0x83, 0xc6, 0x10, 0x66, 0x44, 0x0f, 0x6f, 0xd9, 0x66, 0x45, 0x0f, 0xdb, 0xd9, 0x66, 0x44,
        0x0f, 0x6f, 0xe1, 0x66, 0x41, 0x0f, 0x71, 0xd4, 0x04, 0x66, 0x45, 0x0f, 0xdb, 0xe1, 0x66, 0x45,
        0x0f, 0x6f, 0xe8, 0x66, 0x45, 0x0f, 0x38, 0x00, 0xeb, 0x66, 0x41, 0x0f, 0x71, 0xf5, 0x04, 0x66,
        0x45, 0x0f, 0xdb, 0xee, 0x66, 0x45, 0x0f, 0x6f, 0xd8, 0x66, 0x45, 0x0f, 0x38, 0x00, 0xdc, 0x66,
        0x45, 0x0f, 0xeb, 0xeb, 0x66, 0x41, 0x0f, 0x6f, 0xcd, 0x66, 0x41, 0x0f, 0x38, 0x00, 0xca, 0x66,
        0x0f, 0x6f, 0xd0, 0x66, 0x0f, 0x3a, 0x44, 0xd4, 0x00, 0x66, 0x0f, 0xef, 0xc2, 0x66, 0x0f, 0xef,
        0xc1, 0x48, 0x83, 0xea, 0x10, 0x48, 0x83, 0xfa, 0x10, 0x72, 0x7e, 0xf3, 0x0f, 0x6f, 0x4e, 0x00,
        0x48, 0x83, 0xc6, 0x10, 0x66, 0x44, 0x0f, 0x6f, 0xd9, 0x66, 0x45, 0x0f, 0xdb, 0xd9, 0x66, 0x44,
        0x0f, 0x6f, 0xe1, 0x66, 0x41, 0x0f, 0x71, 0xd4, 0x04, 0x66, 0x45, 0x0f, 0xdb, 0xe1, 0x66, 0x45,
        0x0f, 0x6f, 0xe8, 0x66, 0x45, 0x0f, 0x38, 0x00, 0xeb, 0x66, 0x41, 0x0f, 0x71, 0xf5, 0x04, 0x66,
        0x45, 0x0f, 0xdb, 0xee, 0x66, 0x45, 0x0f, 0x6f, 0xd8, 0x66, 0x45, 0x0f, 0x38, 0x00, 0xdc, 0x66,
        0x45, 0x0f, 0xeb, 0xeb, 0x66, 0x41, 0x0f, 0x6f, 0xcd, 0x66, 0x41, 0x0f, 0x38, 0x00, 0xca, 0x66,
        0x0f, 0x6f, 0xd0, 0x66, 0x0f, 0x3a, 0x44, 0xd5, 0x00, 0x66, 0x0f, 0x6f, 0xd8, 0x66, 0x0f, 0x3a,
        0x44, 0xde, 0x11, 0x66, 0x0f, 0xef, 0xd3, 0x66, 0x0f, 0xef, 0xc2, 0x66, 0x0f, 0xef, 0xc1, 0x48,
        0x83, 0xea, 0x10, 0x48, 0x83, 0xfa, 0x10, 0x73, 0x82, 0x66, 0x0f, 0x6f, 0xd0, 0x66, 0x0f, 0x3a,
        0x44, 0xd4, 0x00, 0x66, 0x0f, 0x6f, 0xd8, 0x66, 0x0f, 0x3a, 0x44, 0xdd, 0x11, 0x66, 0x0f, 0xef,
        0xd3, 0x66, 0x49, 0x0f, 0x3a, 0x16, 0xd0, 0x01, 0x66, 0x49, 0x0f, 0x6e, 0xd8, 0x66, 0x0f, 0x3a,
        0x44, 0xdf, 0x00, 0x66, 0x49, 0x0f, 0x3a, 0x16, 0xd9, 0x01, 0x4d, 0x31, 0xc1, 0x66, 0x49, 0x0f,
        0x6e, 0xd9, 0x66, 0x0f, 0x3a, 0x44, 0xdc, 0x00, 0x66, 0x49, 0x0f, 0x7e, 0xda, 0x66, 0x49, 0x0f,
        0x7e, 0xd3, 0x4d, 0x31, 0xda, 0x66, 0x49, 0x0f, 0x6e, 0xc2, 0x66, 0x44, 0x0f, 0x6f, 0xd8, 0x66,
        0x45, 0x0f, 0xdb, 0xd9, 0x66, 0x44, 0x0f, 0x6f, 0xe0, 0x66, 0x41, 0x0f, 0x71, 0xd4, 0x04, 0x66,
        0x45, 0x0f, 0xdb, 0xe1, 0x66, 0x45, 0x0f, 0x6f, 0xe8, 0x66, 0x45, 0x0f, 0x38, 0x00, 0xeb, 0x66,
        0x41, 0x0f, 0x71, 0xf5, 0x04, 0x66, 0x45, 0x0f, 0xdb, 0xee, 0x66, 0x45, 0x0f, 0x6f, 0xd8, 0x66,
        0x45, 0x0f, 0x38, 0x00, 0xdc, 0x66, 0x45, 0x0f, 0xeb, 0xeb, 0x66, 0x41, 0x0f, 0x6f, 0xc5, 0x66,
        0x48, 0x0f, 0x7e, 0xc0, 0x48, 0x0f, 0xc8, 0x48, 0x89, 0xc0, 0xc3
    ]

    /** 正常域核（219 字节）。 */
    private static let NORM_CODE: Array<UInt8> = [
        0xf3, 0x0f, 0x6f, 0x61, 0x00, 0xf3, 0x0f, 0x6f, 0x69, 0x10, 0xf3, 0x0f, 0x6f, 0x71, 0x20, 0xf3,
        0x0f, 0x6f, 0x79, 0x30, 0xf3, 0x44, 0x0f, 0x6f, 0x51, 0x40, 0x66, 0x48, 0x0f, 0x6e, 0xc7, 0x66,
        0x0f, 0xef, 0xc9, 0x66, 0x0f, 0x6c, 0xc1, 0xf3, 0x0f, 0x6f, 0x4e, 0x00, 0x48, 0x83, 0xc6, 0x10,
        0x66, 0x41, 0x0f, 0x38, 0x00, 0xca, 0x66, 0x0f, 0x6f, 0xd0, 0x66, 0x0f, 0x3a, 0x44, 0xd4, 0x00,
        0x66, 0x0f, 0xef, 0xc2, 0x66, 0x0f, 0xef, 0xc1, 0x48, 0x83, 0xea, 0x10, 0x48, 0x83, 0xfa, 0x10,
        0x72, 0x39, 0xf3, 0x0f, 0x6f, 0x4e, 0x00, 0x48, 0x83, 0xc6, 0x10, 0x66, 0x41, 0x0f, 0x38, 0x00,
        0xca, 0x66, 0x0f, 0x6f, 0xd0, 0x66, 0x0f, 0x3a, 0x44, 0xd5, 0x00, 0x66, 0x0f, 0x6f, 0xd8, 0x66,
        0x0f, 0x3a, 0x44, 0xde, 0x11, 0x66, 0x0f, 0xef, 0xd3, 0x66, 0x0f, 0xef, 0xc2, 0x66, 0x0f, 0xef,
        0xc1, 0x48, 0x83, 0xea, 0x10, 0x48, 0x83, 0xfa, 0x10, 0x73, 0xc5, 0x66, 0x0f, 0x6f, 0xd0, 0x66,
        0x0f, 0x3a, 0x44, 0xd4, 0x00, 0x66, 0x0f, 0x6f, 0xd8, 0x66, 0x0f, 0x3a, 0x44, 0xdd, 0x11, 0x66,
        0x0f, 0xef, 0xd3, 0x66, 0x49, 0x0f, 0x3a, 0x16, 0xd0, 0x01, 0x66, 0x49, 0x0f, 0x6e, 0xd8, 0x66,
        0x0f, 0x3a, 0x44, 0xdf, 0x00, 0x66, 0x49, 0x0f, 0x3a, 0x16, 0xd9, 0x01, 0x4d, 0x31, 0xc1, 0x66,
        0x49, 0x0f, 0x6e, 0xd9, 0x66, 0x0f, 0x3a, 0x44, 0xdc, 0x00, 0x66, 0x49, 0x0f, 0x7e, 0xda, 0x66,
        0x49, 0x0f, 0x7e, 0xd3, 0x4d, 0x31, 0xda, 0x4c, 0x89, 0xd0, 0xc3
    ]

    static func supports(poly: UInt64): Bool {
        poly == 0x42F0E1EBA9EA3693u64 || poly == 0x1Bu64 || poly == 0xAD93D23594C935A9u64
    }

    static func supportsNormal(poly: UInt64): Bool {
        poly == 0x42F0E1EBA9EA3693u64
    }

    static func available(): Bool {
        if (!nativeEnabled) {
            return false
        }
        ensureReady()
        fn.isSome() || fnNorm.isSome()
    }

    static func update(crc: UInt64, data: Array<Byte>, aligned: Int64, poly: UInt64): ?UInt64 {
        if (!nativeEnabled || aligned < 16 || aligned > data.size || !supports(poly)) {
            return None
        }
        if (!ensureReady()) {
            return None
        }
        let selected = match (poly) {
            case 0x42F0E1EBA9EA3693u64 => constsXz
            case 0x1Bu64 => constsIso
            case _ => constsRedis
        }
        call(fn, selected, crc, data, aligned)
    }

    static func updateNormal(crc: UInt64, data: Array<Byte>, aligned: Int64): ?UInt64 {
        if (!nativeEnabled || aligned < 16 || aligned > data.size) {
            return None
        }
        if (!ensureReady()) {
            return None
        }
        call(fnNorm, constsNorm, crc, data, aligned)
    }

    private static func call(f: ?CFunc<(UInt64, CPointer<Byte>, UInt64, CPointer<UInt64>) -> UInt64>,
        c: ?Array<UInt64>, crc: UInt64, data: Array<Byte>, aligned: Int64): ?UInt64 {
        match (f) {
            case Some(fn2) =>
                match (c) {
                    case Some(consts) =>
                        let handle = unsafe { acquireArrayRawData<Byte>(data) }
                        let chandle = unsafe { acquireArrayRawData<UInt64>(consts) }
                        try {
                            Some(unsafe { fn2(crc, handle.pointer, UInt64(aligned), chandle.pointer) })
                        } finally {
                            unsafe { releaseArrayRawData(handle) }
                            unsafe { releaseArrayRawData(chandle) }
                        }
                    case None => None
                }
            case None => None
        }
    }

    static func setNativeEnabled(value: Bool): Unit {
        nativeEnabled = value
    }

    static func resetForTest(): Unit {
        synchronized(lock) {
            ready = false
            fn = None
            fnNorm = None
            constsXz = None
            constsIso = None
            constsRedis = None
            constsNorm = None
            codes.clear()
        }
    }

    private static func ensureReady(): Bool {
        synchronized(lock) {
            if (ready) {
                fn.isSome() || fnNorm.isSome()
            } else {
                ready = true
                if (!envEnabled() || !hasPclmul()) {
                    false
                } else {
                    fn = make(REF_CODE)
                    fnNorm = make(NORM_CODE)
                    constsXz = CrcGf.reflectX86Constants(0x42F0E1EBA9EA3693u64, true)
                    constsIso = CrcGf.reflectX86Constants(0x1Bu64, true)
                    constsRedis = CrcGf.reflectX86Constants(0xAD93D23594C935A9u64, true)
                    constsNorm = CrcGf.reflectX86Constants(0x42F0E1EBA9EA3693u64, false)
                    fn.isSome() || fnNorm.isSome()
                }
            }
        }
    }

    private static func make(bytes: Array<UInt8>): ?CFunc<(UInt64, CPointer<Byte>, UInt64, CPointer<UInt64>) -> UInt64> {
        match (CodeBuffer.alloc(bytes.size + 64)) {
            case Some(buffer) =>
                if (!buffer.write(bytes, 0) || !buffer.seal()) {
                    None
                } else {
                    codes.add(buffer)
                    Some(CFunc<(UInt64, CPointer<Byte>, UInt64, CPointer<UInt64>) -> UInt64>(
                        CPointer<Unit>(buffer.rawPointer())))
                }
            case None => None
        }
    }

    private static func envEnabled(): Bool {
        match (getVariable("F_UTIL_CRC_HW")) {
            case Some(v) => v != "0"
            case None => true
        }
    }

    private static func hasPclmul(): Bool {
        try {
            let f = File("/proc/cpuinfo", OpenMode.Read)
            let text = try {
                StringReader(f).readToEnd()
            } finally {
                f.close()
            }
            text.contains("pclmulqdq") && text.contains("ssse3")
        } catch (_: Exception) {
            false
        }
    }
}
