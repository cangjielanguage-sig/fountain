      <Box style={{ flex: 1, background: '#0B1220', borderRadius: 12, border: '1px solid #1E293B', padding: 18, flexDirection: 'column' }}>
        <Text style={{ fontSize: 13, color: '#64748B', marginBottom: 8 }}>接口</Text>
        <Text style={{ fontSize: 12, color: '#E2E8F0', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"public interface UserService <: RootService {"}</Text>
        <Text style={{ fontSize: 12, color: '#38BDF8', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"    func queryUser(id: Int64): UserPO"}</Text>
        <Text style={{ fontSize: 12, color: '#94A3B8', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"    ..."}</Text>
        <Text style={{ fontSize: 12, color: '#E2E8F0', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"}"}</Text>
        <Text style={{ fontSize: 13, color: '#64748B', lineHeight: 1.7, marginTop: 'auto' }}>RootService 提供：executor() / executor(name) / dao 泛型 / dao 泛型带驱动</Text>
      </Box>
      <Box style={{ flex: 1, background: '#0B1220', borderRadius: 12, border: '1px solid #38BDF8', padding: 18, flexDirection: 'column' }}>
        <Text style={{ fontSize: 13, color: '#38BDF8', marginBottom: 8 }}>实现</Text>
        <Text style={{ fontSize: 12, color: '#F59E0B', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"@TransactionalService   // 不需要事务时用 @Bean"}</Text>
        <Text style={{ fontSize: 12, color: '#E2E8F0', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"public class UserServiceImpl <: UserService {"}</Text>
        <Text style={{ fontSize: 12, color: '#38BDF8', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"    public func queryUser(id: Int64): UserPO {"}</Text>
        <Text style={{ fontSize: 12, color: '#38BDF8', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"        executor().findUser(id)   // 可直接当 UserDAO 用"}</Text>
        <Text style={{ fontSize: 12, color: '#38BDF8', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"    }"}</Text>
        <Text style={{ fontSize: 12, color: '#E2E8F0', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"}"}</Text>
      </Box>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'row', gap: 16 }}>
      <Box style={{ flex: 1, background: 'rgba(245,158,11,0.07)', borderRadius: 12, border: '1px solid #F59E0B', padding: 20, flexDirection: 'column' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#F59E0B' }}>铁律一</Text>
        <Text style={{ fontSize: 15, color: '#E2E8F0', lineHeight: 1.75, marginTop: 10 }}>每次调用 DAO 函数都必须从 executor() 开始。</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.75, marginTop: 10 }}>不要试图声明 SqlExecutor 或 DAO 接口类型的变量 —— 它缓存在 ThreadLocal 里按驱动名区分，存成字段会拿到别的线程的连接。</Text>
      </Box>
      <Box style={{ flex: 1, background: 'rgba(245,158,11,0.07)', borderRadius: 12, border: '1px solid #F59E0B', padding: 20, flexDirection: 'column' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#F59E0B' }}>铁律二</Text>
        <Text style={{ fontSize: 15, color: '#E2E8F0', lineHeight: 1.75, marginTop: 10 }}>一个 DAO 函数只执行一个 SQL（或一次分页查询：一次 count 加一次列表）。</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.75, marginTop: 10 }}>同一个 SqlExecutor 上不允许并发：上一次查询结果未关闭时再执行会抛 ORMException。</Text>
      </Box>
    </Box>
  </Box>

