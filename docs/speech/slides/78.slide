    <Box style={{ width: 4, height: 40, background: '#38BDF8' }} />
    <Box style={{ flexDirection: 'column', flex: 1 }}>
      <Text style={{ fontSize: 13, color: '#64748B', lineHeight: 1.4 }}>第 12 章 · ORM f_orm · 12.1 续</Text>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E2E8F0', lineHeight: 1.3 }}>三个角色之三：Service 与两条铁律</Text>
    </Box>
    <Text style={{ fontSize: 13, color: '#64748B' }}>最常见的线上事故来源</Text>
  </Box>

  <Box style={{ height: 540, flexDirection: 'column', gap: 16 }}>
