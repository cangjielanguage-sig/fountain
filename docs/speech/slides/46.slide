    <Box style={{ flex: 1, flexDirection: 'row', gap: 16 }}>
      <Box style={{ width: 460, background: '#0B1220', borderRadius: 12, border: '1px solid #1E293B', padding: 20, flexDirection: 'column' }}>
        <Text style={{ fontSize: 14, color: '#64748B', marginBottom: 10 }}>一把钥匙</Text>
        <Text style={{ fontSize: 15, color: '#22D3EE', lineHeight: 1.9, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>@DataAssist[equal hash tostring props fields]</Text>
