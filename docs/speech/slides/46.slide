        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#38BDF8', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1 }}>1</Text>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E2E8F0', marginTop: 12 }}>进来：变成对象</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.7, marginTop: 8 }}>HTTP 请求 / 数据库行 / 配置 → 对象</Text>
      </Box>
      <Box style={{ flex: 1, background: '#111C2E', borderRadius: 12, border: '1px solid #1E293B', padding: 20, flexDirection: 'column' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#22D3EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1 }}>2</Text>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E2E8F0', marginTop: 12 }}>搬运：对象到对象</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.7, marginTop: 8 }}>PO → DTO、DTO → Entity</Text>
      </Box>
      <Box style={{ flex: 1, background: '#111C2E', borderRadius: 12, border: '1px solid #1E293B', padding: 20, flexDirection: 'column' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#F59E0B', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1 }}>3</Text>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E2E8F0', marginTop: 12 }}>出去：变成响应</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.7, marginTop: 8 }}>对象 → JSON / 其它格式</Text>
      </Box>
