      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E2E8F0', lineHeight: 1.3 }}>IsUUID 注解与 IdMaker</Text>
    </Box>
    <Text style={{ fontSize: 13, color: '#64748B' }}>35 行源码 · 雪花算法</Text>
  </Box>

