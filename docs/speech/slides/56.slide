        <Text style={{ fontSize: 13, color: '#94A3B8', lineHeight: 1.75, marginTop: 10, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"@IsUUID            // 必须是 UUID"}</Text>
