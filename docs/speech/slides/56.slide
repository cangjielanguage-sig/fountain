        <Text style={{ fontSize: 13, color: '#64748B', marginBottom: 8 }}>f_util/src/IsUUID.cj（35 行）</Text>
        <Text style={{ fontSize: 13, color: '#E2E8F0', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"@Annotation[target: [MemberVariable, MemberProperty, Parameter]]"}</Text>
        <Text style={{ fontSize: 13, color: '#E2E8F0', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"public class IsUUID <: Validator {"}</Text>
        <Text style={{ fontSize: 13, color: '#38BDF8', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"    public func validate(value: ?String): Bool {"}</Text>
        <Text style={{ fontSize: 13, color: '#38BDF8', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"        if(let Some(x) <- value){ UUID.tryParse(x).isSome() } else { false }"}</Text>
        <Text style={{ fontSize: 13, color: '#38BDF8', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"    }"}</Text>
        <Text style={{ fontSize: 13, color: '#E2E8F0', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"    public prop description: String { get(){ '必须是UUID格式的字符串' } }"}</Text>
        <Text style={{ fontSize: 13, color: '#E2E8F0', lineHeight: 1.7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{"}"}</Text>
      </Box>
