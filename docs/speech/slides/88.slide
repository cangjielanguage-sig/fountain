      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E2E8F0', lineHeight: 1.3 }}>MVC 怎么挑 handler</Text>
    </Box>
    <Text style={{ fontSize: 13, color: '#64748B' }}>这决定了你的类该怎么设计</Text>
  </Box>

