      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E2E8F0', lineHeight: 1.3 }}>课程地图</Text>
    </Box>
    <Text style={{ fontSize: 13, color: '#64748B' }}>可按章节裁剪</Text>
  </Box>

  <Box style={{ height: 540, flexDirection: 'column', gap: 16 }}>
