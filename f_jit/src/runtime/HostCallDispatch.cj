        case (10u16, 1u16) => boxHostResult(invoke1<ArrayList<Any>, Float64>(fn, asList(c0)))
        case (10u16, 2u16) => boxHostResult(invoke1<ArrayList<Any>, Bool>(fn, asList(c0)))
        case (10u16, 3u16) => boxHostResult(invoke1<ArrayList<Any>, Unit>(fn, asList(c0)))
        case (10u16, 4u16) => boxHostResult(invoke1<ArrayList<Any>, String>(fn, asList(c0)))
