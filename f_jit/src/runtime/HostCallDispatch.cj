        case (11u16, 14u16) => boxHostResult(invoke1<HashMap<ConstMapKey, Any>, Object>(fn, asMap(c0)))
        case (14u16, 0u16) => boxHostResult(invoke1<Object, Int64>(fn, asObj(c0)))
        case (14u16, 1u16) => boxHostResult(invoke1<Object, Float64>(fn, asObj(c0)))
        case (14u16, 2u16) => boxHostResult(invoke1<Object, Bool>(fn, asObj(c0)))
        case (14u16, 3u16) => boxHostResult(invoke1<Object, Unit>(fn, asObj(c0)))
