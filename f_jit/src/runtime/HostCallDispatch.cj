        case (10u16, 10u16) => boxHostResult(invoke1<ArrayList<Any>, ArrayList<Any>>(fn, asList(c0)))
        case (10u16, 11u16) => boxHostResult(invoke1<ArrayList<Any>, HashMap<ConstMapKey, Any>>(fn, asList(c0)))
        case (10u16, 14u16) => boxHostResult(invoke1<ArrayList<Any>, Object>(fn, asList(c0)))
        case (11u16, 0u16) => boxHostResult(invoke1<HashMap<ConstMapKey, Any>, Int64>(fn, asMap(c0)))
        case (11u16, 1u16) => boxHostResult(invoke1<HashMap<ConstMapKey, Any>, Float64>(fn, asMap(c0)))
        case (11u16, 2u16) => boxHostResult(invoke1<HashMap<ConstMapKey, Any>, Bool>(fn, asMap(c0)))
        case (11u16, 3u16) => boxHostResult(invoke1<HashMap<ConstMapKey, Any>, Unit>(fn, asMap(c0)))
