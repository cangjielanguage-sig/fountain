package fountain::f_jit.runtime

import std.collection.ArrayList
import std.collection.HashMap
import std.math.numeric.Decimal
import std.time.DateTime
import fountain::f_jit.base.ErrCode
import fountain::f_jit.bytecode.ConstMapKey

/**
 * H63 的**签名分派**（生成物）—— 按描述符的 `(T1..Tn, R)` 选择静态类型并调用宿主闭包。
 *
 * Cangjie 的 `is` / 类型模式绑定要求静态类型，而描述符是运行期数据，故调用面必须把
 * 签名空间物化为静态分支。M2 支持 **0–2 元**（与 `SignatureVerifier` 的验签面一致）；
 * 参数/返回码 = `0–8、10、11、14`。
 *
 * 生成规则：每个分支 `invokeN<P1..Pn, R>(fn, ctx, args…)`；绑定失败（理论不可达——
 * 验签已通过）⇒ 99（引擎侧兜底）。
 *
 * **维护**：本文件由签名空间生成，改动分派顺序/支持面时同步重新生成，勿手改分支。
 */

/**
 * 按描述符调用宿主闭包；返回 **原始仓颉值**（未装箱为 cell）。
 *
 * 前置条件（由 `hostCallTrampoline` 保证）：`sig.validate()`、`params.size == a.size - 1`、
 * 条目已验签。任何绑定失败都属引擎不变式破坏 ⇒ 99。
 */
internal func dispatchHostCall(fn: Any, sig: SignatureDescriptor, a: Array<Int64>): Any {
    if (sig.params.size == 0) {
        return dispatchHostCall0(fn, sig.ret)
    }
    if (sig.params.size == 1) {
        return dispatchHostCall1(fn, sig.params[0], a[1], sig.ret)
    }
    dispatchHostCall2(fn, sig.params[0], sig.params[1], a[1], a[2], sig.ret)
}

private func invoke0<R>(f: Any): R {
    if (let g: () -> R <- f) {
        return g()
    }
    failWith(ErrCode.HELPER_PANIC)
}

private func invoke1<P, R>(f: Any, p: P): R {
    if (let g: (P) -> R <- f) {
        return g(p)
    }
    failWith(ErrCode.HELPER_PANIC)
}

private func invoke2<P1, P2, R>(f: Any, p1: P1, p2: P2): R {
    if (let g: (P1, P2) -> R <- f) {
        return g(p1, p2)
    }
    failWith(ErrCode.HELPER_PANIC)
}

private func dispatchHostCall0(fn: Any, r: UInt16): Any {
    match (r) {
        case 0u16 => boxHostResult(invoke0<Int64>(fn))
        case 1u16 => boxHostResult(invoke0<Float64>(fn))
        case 2u16 => boxHostResult(invoke0<Bool>(fn))
        case 3u16 => boxHostResult(invoke0<Unit>(fn))
        case 4u16 => boxHostResult(invoke0<String>(fn))
        case 5u16 => boxHostResult(invoke0<Decimal>(fn))
        case 6u16 => boxHostResult(invoke0<DateTime>(fn))
        case 7u16 => boxHostResult(invoke0<Duration>(fn))
        case 8u16 => boxHostResult(invoke0<Range<Int64>>(fn))
        case 10u16 => boxHostResult(invoke0<ArrayList<Any>>(fn))
        case 11u16 => boxHostResult(invoke0<HashMap<ConstMapKey, Any>>(fn))
        case 14u16 => boxHostResult(invoke0<Object>(fn))
        case _ => failWith(ErrCode.HELPER_PANIC)
    }
}
private func dispatchHostCall1(fn: Any, t0: UInt16, c0: Int64, r: UInt16): Any {
    match ((t0, r)) {
        case (0u16, 0u16) => boxHostResult(invoke1<Int64, Int64>(fn, asI64(c0)))
        case (0u16, 1u16) => boxHostResult(invoke1<Int64, Float64>(fn, asI64(c0)))
        case (0u16, 2u16) => boxHostResult(invoke1<Int64, Bool>(fn, asI64(c0)))
        case (0u16, 3u16) => boxHostResult(invoke1<Int64, Unit>(fn, asI64(c0)))
        case (0u16, 4u16) => boxHostResult(invoke1<Int64, String>(fn, asI64(c0)))
        case (0u16, 5u16) => boxHostResult(invoke1<Int64, Decimal>(fn, asI64(c0)))
        case (0u16, 6u16) => boxHostResult(invoke1<Int64, DateTime>(fn, asI64(c0)))
        case (0u16, 7u16) => boxHostResult(invoke1<Int64, Duration>(fn, asI64(c0)))
        case (0u16, 8u16) => boxHostResult(invoke1<Int64, Range<Int64>>(fn, asI64(c0)))
        case (0u16, 10u16) => boxHostResult(invoke1<Int64, ArrayList<Any>>(fn, asI64(c0)))
        case (0u16, 11u16) => boxHostResult(invoke1<Int64, HashMap<ConstMapKey, Any>>(fn, asI64(c0)))
        case (0u16, 14u16) => boxHostResult(invoke1<Int64, Object>(fn, asI64(c0)))
        case (1u16, 0u16) => boxHostResult(invoke1<Float64, Int64>(fn, asF64(c0)))
        case (1u16, 1u16) => boxHostResult(invoke1<Float64, Float64>(fn, asF64(c0)))
        case (1u16, 2u16) => boxHostResult(invoke1<Float64, Bool>(fn, asF64(c0)))
        case (1u16, 3u16) => boxHostResult(invoke1<Float64, Unit>(fn, asF64(c0)))
        case (1u16, 4u16) => boxHostResult(invoke1<Float64, String>(fn, asF64(c0)))
        case (1u16, 5u16) => boxHostResult(invoke1<Float64, Decimal>(fn, asF64(c0)))
        case (1u16, 6u16) => boxHostResult(invoke1<Float64, DateTime>(fn, asF64(c0)))
        case (1u16, 7u16) => boxHostResult(invoke1<Float64, Duration>(fn, asF64(c0)))
        case (1u16, 8u16) => boxHostResult(invoke1<Float64, Range<Int64>>(fn, asF64(c0)))
        case (1u16, 10u16) => boxHostResult(invoke1<Float64, ArrayList<Any>>(fn, asF64(c0)))
        case (1u16, 11u16) => boxHostResult(invoke1<Float64, HashMap<ConstMapKey, Any>>(fn, asF64(c0)))
        case (1u16, 14u16) => boxHostResult(invoke1<Float64, Object>(fn, asF64(c0)))
        case (2u16, 0u16) => boxHostResult(invoke1<Bool, Int64>(fn, asBool(c0)))
        case (2u16, 1u16) => boxHostResult(invoke1<Bool, Float64>(fn, asBool(c0)))
        case (2u16, 2u16) => boxHostResult(invoke1<Bool, Bool>(fn, asBool(c0)))
        case (2u16, 3u16) => boxHostResult(invoke1<Bool, Unit>(fn, asBool(c0)))
        case (2u16, 4u16) => boxHostResult(invoke1<Bool, String>(fn, asBool(c0)))
        case (2u16, 5u16) => boxHostResult(invoke1<Bool, Decimal>(fn, asBool(c0)))
        case (2u16, 6u16) => boxHostResult(invoke1<Bool, DateTime>(fn, asBool(c0)))
        case (2u16, 7u16) => boxHostResult(invoke1<Bool, Duration>(fn, asBool(c0)))
        case (2u16, 8u16) => boxHostResult(invoke1<Bool, Range<Int64>>(fn, asBool(c0)))
        case (2u16, 10u16) => boxHostResult(invoke1<Bool, ArrayList<Any>>(fn, asBool(c0)))
        case (2u16, 11u16) => boxHostResult(invoke1<Bool, HashMap<ConstMapKey, Any>>(fn, asBool(c0)))
        case (2u16, 14u16) => boxHostResult(invoke1<Bool, Object>(fn, asBool(c0)))
        case (3u16, 0u16) => boxHostResult(invoke1<Unit, Int64>(fn, asUnit(c0)))
        case (3u16, 1u16) => boxHostResult(invoke1<Unit, Float64>(fn, asUnit(c0)))
        case (3u16, 2u16) => boxHostResult(invoke1<Unit, Bool>(fn, asUnit(c0)))
        case (3u16, 3u16) => boxHostResult(invoke1<Unit, Unit>(fn, asUnit(c0)))
        case (3u16, 4u16) => boxHostResult(invoke1<Unit, String>(fn, asUnit(c0)))
        case (3u16, 5u16) => boxHostResult(invoke1<Unit, Decimal>(fn, asUnit(c0)))
        case (3u16, 6u16) => boxHostResult(invoke1<Unit, DateTime>(fn, asUnit(c0)))
        case (3u16, 7u16) => boxHostResult(invoke1<Unit, Duration>(fn, asUnit(c0)))
        case (3u16, 8u16) => boxHostResult(invoke1<Unit, Range<Int64>>(fn, asUnit(c0)))
        case (3u16, 10u16) => boxHostResult(invoke1<Unit, ArrayList<Any>>(fn, asUnit(c0)))
        case (3u16, 11u16) => boxHostResult(invoke1<Unit, HashMap<ConstMapKey, Any>>(fn, asUnit(c0)))
        case (3u16, 14u16) => boxHostResult(invoke1<Unit, Object>(fn, asUnit(c0)))
        case (4u16, 0u16) => boxHostResult(invoke1<String, Int64>(fn, asStr(c0)))
        case (4u16, 1u16) => boxHostResult(invoke1<String, Float64>(fn, asStr(c0)))
        case (4u16, 2u16) => boxHostResult(invoke1<String, Bool>(fn, asStr(c0)))
        case (4u16, 3u16) => boxHostResult(invoke1<String, Unit>(fn, asStr(c0)))
        case (4u16, 4u16) => boxHostResult(invoke1<String, String>(fn, asStr(c0)))
        case (4u16, 5u16) => boxHostResult(invoke1<String, Decimal>(fn, asStr(c0)))
        case (4u16, 6u16) => boxHostResult(invoke1<String, DateTime>(fn, asStr(c0)))
