        case (5u16, 4u16) => boxHostResult(invoke1<Decimal, String>(fn, asDec(c0)))
        case (5u16, 5u16) => boxHostResult(invoke1<Decimal, Decimal>(fn, asDec(c0)))
        case (5u16, 6u16) => boxHostResult(invoke1<Decimal, DateTime>(fn, asDec(c0)))
        case (5u16, 7u16) => boxHostResult(invoke1<Decimal, Duration>(fn, asDec(c0)))
