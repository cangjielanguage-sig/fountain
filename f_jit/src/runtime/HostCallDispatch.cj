private func dispatchHostCall2(fn: Any, t0: UInt16, t1: UInt16, c0: Int64, c1: Int64, r: UInt16): Any {
    match ((t0, t1, r)) {
        case (0u16, 0u16, 0u16) => boxHostResult(invoke2<Int64, Int64, Int64>(fn, asI64(c0), asI64(c1)))
        case (0u16, 0u16, 1u16) => boxHostResult(invoke2<Int64, Int64, Float64>(fn, asI64(c0), asI64(c1)))
        case (0u16, 0u16, 2u16) => boxHostResult(invoke2<Int64, Int64, Bool>(fn, asI64(c0), asI64(c1)))
        case (0u16, 0u16, 3u16) => boxHostResult(invoke2<Int64, Int64, Unit>(fn, asI64(c0), asI64(c1)))
        case (0u16, 0u16, 4u16) => boxHostResult(invoke2<Int64, Int64, String>(fn, asI64(c0), asI64(c1)))
        case (0u16, 0u16, 5u16) => boxHostResult(invoke2<Int64, Int64, Decimal>(fn, asI64(c0), asI64(c1)))
        case (0u16, 0u16, 6u16) => boxHostResult(invoke2<Int64, Int64, DateTime>(fn, asI64(c0), asI64(c1)))
        case (0u16, 0u16, 7u16) => boxHostResult(invoke2<Int64, Int64, Duration>(fn, asI64(c0), asI64(c1)))
        case (0u16, 0u16, 8u16) => boxHostResult(invoke2<Int64, Int64, Range<Int64>>(fn, asI64(c0), asI64(c1)))
        case (0u16, 0u16, 10u16) => boxHostResult(invoke2<Int64, Int64, ArrayList<Any>>(fn, asI64(c0), asI64(c1)))
        case (0u16, 0u16, 11u16) => boxHostResult(invoke2<Int64, Int64, HashMap<ConstMapKey, Any>>(fn, asI64(c0), asI64(c1)))
        case (0u16, 0u16, 14u16) => boxHostResult(invoke2<Int64, Int64, Object>(fn, asI64(c0), asI64(c1)))
        case (0u16, 1u16, 0u16) => boxHostResult(invoke2<Int64, Float64, Int64>(fn, asI64(c0), asF64(c1)))
        case (0u16, 1u16, 1u16) => boxHostResult(invoke2<Int64, Float64, Float64>(fn, asI64(c0), asF64(c1)))
        case (0u16, 1u16, 2u16) => boxHostResult(invoke2<Int64, Float64, Bool>(fn, asI64(c0), asF64(c1)))
        case (0u16, 1u16, 3u16) => boxHostResult(invoke2<Int64, Float64, Unit>(fn, asI64(c0), asF64(c1)))
        case (0u16, 1u16, 4u16) => boxHostResult(invoke2<Int64, Float64, String>(fn, asI64(c0), asF64(c1)))
        case (0u16, 1u16, 5u16) => boxHostResult(invoke2<Int64, Float64, Decimal>(fn, asI64(c0), asF64(c1)))
        case (0u16, 1u16, 6u16) => boxHostResult(invoke2<Int64, Float64, DateTime>(fn, asI64(c0), asF64(c1)))
        case (0u16, 1u16, 7u16) => boxHostResult(invoke2<Int64, Float64, Duration>(fn, asI64(c0), asF64(c1)))
        case (0u16, 1u16, 8u16) => boxHostResult(invoke2<Int64, Float64, Range<Int64>>(fn, asI64(c0), asF64(c1)))
        case (0u16, 1u16, 10u16) => boxHostResult(invoke2<Int64, Float64, ArrayList<Any>>(fn, asI64(c0), asF64(c1)))
        case (0u16, 1u16, 11u16) => boxHostResult(invoke2<Int64, Float64, HashMap<ConstMapKey, Any>>(fn, asI64(c0), asF64(c1)))
        case (0u16, 1u16, 14u16) => boxHostResult(invoke2<Int64, Float64, Object>(fn, asI64(c0), asF64(c1)))
        case (0u16, 2u16, 0u16) => boxHostResult(invoke2<Int64, Bool, Int64>(fn, asI64(c0), asBool(c1)))
        case (0u16, 2u16, 1u16) => boxHostResult(invoke2<Int64, Bool, Float64>(fn, asI64(c0), asBool(c1)))
        case (0u16, 2u16, 2u16) => boxHostResult(invoke2<Int64, Bool, Bool>(fn, asI64(c0), asBool(c1)))
        case (0u16, 2u16, 3u16) => boxHostResult(invoke2<Int64, Bool, Unit>(fn, asI64(c0), asBool(c1)))
