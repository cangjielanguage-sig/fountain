        case (5u16, 14u16) => boxHostResult(invoke1<Decimal, Object>(fn, asDec(c0)))
        case (6u16, 0u16) => boxHostResult(invoke1<DateTime, Int64>(fn, asDt(c0)))
        case (6u16, 1u16) => boxHostResult(invoke1<DateTime, Float64>(fn, asDt(c0)))
        case (6u16, 2u16) => boxHostResult(invoke1<DateTime, Bool>(fn, asDt(c0)))
        case (6u16, 3u16) => boxHostResult(invoke1<DateTime, Unit>(fn, asDt(c0)))
        case (6u16, 4u16) => boxHostResult(invoke1<DateTime, String>(fn, asDt(c0)))
        case (6u16, 5u16) => boxHostResult(invoke1<DateTime, Decimal>(fn, asDt(c0)))
        case (6u16, 6u16) => boxHostResult(invoke1<DateTime, DateTime>(fn, asDt(c0)))
        case (6u16, 7u16) => boxHostResult(invoke1<DateTime, Duration>(fn, asDt(c0)))
        case (6u16, 8u16) => boxHostResult(invoke1<DateTime, Range<Int64>>(fn, asDt(c0)))
        case (6u16, 10u16) => boxHostResult(invoke1<DateTime, ArrayList<Any>>(fn, asDt(c0)))
        case (6u16, 11u16) => boxHostResult(invoke1<DateTime, HashMap<ConstMapKey, Any>>(fn, asDt(c0)))
        case (6u16, 14u16) => boxHostResult(invoke1<DateTime, Object>(fn, asDt(c0)))
        case (7u16, 0u16) => boxHostResult(invoke1<Duration, Int64>(fn, asDur(c0)))
        case (7u16, 1u16) => boxHostResult(invoke1<Duration, Float64>(fn, asDur(c0)))
        case (7u16, 2u16) => boxHostResult(invoke1<Duration, Bool>(fn, asDur(c0)))
        case (7u16, 3u16) => boxHostResult(invoke1<Duration, Unit>(fn, asDur(c0)))
        case (7u16, 4u16) => boxHostResult(invoke1<Duration, String>(fn, asDur(c0)))
        case (7u16, 5u16) => boxHostResult(invoke1<Duration, Decimal>(fn, asDur(c0)))
        case (7u16, 6u16) => boxHostResult(invoke1<Duration, DateTime>(fn, asDur(c0)))
        case (7u16, 7u16) => boxHostResult(invoke1<Duration, Duration>(fn, asDur(c0)))
        case (7u16, 8u16) => boxHostResult(invoke1<Duration, Range<Int64>>(fn, asDur(c0)))
        case (7u16, 10u16) => boxHostResult(invoke1<Duration, ArrayList<Any>>(fn, asDur(c0)))
        case (7u16, 11u16) => boxHostResult(invoke1<Duration, HashMap<ConstMapKey, Any>>(fn, asDur(c0)))
        case (7u16, 14u16) => boxHostResult(invoke1<Duration, Object>(fn, asDur(c0)))
        case (8u16, 0u16) => boxHostResult(invoke1<Range<Int64>, Int64>(fn, asRange(c0)))
        case (8u16, 1u16) => boxHostResult(invoke1<Range<Int64>, Float64>(fn, asRange(c0)))
        case (8u16, 2u16) => boxHostResult(invoke1<Range<Int64>, Bool>(fn, asRange(c0)))
        case (8u16, 3u16) => boxHostResult(invoke1<Range<Int64>, Unit>(fn, asRange(c0)))
