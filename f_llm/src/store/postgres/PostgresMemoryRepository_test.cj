package fountain::f_llm.store.postgres

import fountain::f_llm.store.*

import std.collection.*
import std.unittest.*
import std.unittest.testmacro.*

import fountain::f_orm.*


import postgres_driver.registerPostgresDriver

/** 集成用例用：固定 1024 维，避免 vector(1024) 列宽不匹配 */
class Fixed1024Embedder <: Embedder {
    public func embed(text: String): Array<Float64> {
        let vector = Array<Float64>(1024, repeat: 0.01f64)
        vector
    }

    public func embedColbert(text: String): Array<Array<Float64>> {
        [[0.01f64]]
    }

    public func tokenize(text: String): HashMap<Int64, Float64> {
        let tokens = HashMap<Int64, Float64>()
        tokens[1] = 1.0f64
        tokens
    }
}

@Test
public class PostgresMemoryRepositoryTest {
    private static let URL = 'postgres://fllm_test:fllm_test@127.0.0.1:5432/fllm_test'

    private func repository(): ?PostgresMemoryRepository {
        try{
            registerPostgresDriver()
            let driver = DriverManager.getDriver('postgres').getOrThrow()
            ORM.register(driver, URL, default: true)
            let executor = ORM.executor('postgres')
            executor.setSql('''
                CREATE TABLE IF NOT EXISTS llm_memory (
                  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                  user_id BIGINT NOT NULL,
                  namespace VARCHAR(32) NOT NULL,
                  title VARCHAR(128) NOT NULL,
                  content TEXT,
                  kind VARCHAR(32) NOT NULL DEFAULT 'note',
                  save_time TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'utc'),
                  update_time TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'utc'),
                  CONSTRAINT uk_memory_user_ns_title UNIQUE (user_id, namespace, title)
                )
            ''').update
            executor.setSql('''
                CREATE TABLE IF NOT EXISTS llm_memory_vector (
                  memory_id BIGINT PRIMARY KEY,
                  model VARCHAR(64) NOT NULL,
                  title_dense vector(1024),
                  content_dense vector(1024),
                  title_colbert BYTEA,
                  content_colbert BYTEA,
                  has_sparse BOOLEAN NOT NULL DEFAULT FALSE,
                  has_colbert BOOLEAN NOT NULL DEFAULT FALSE,
                  update_time TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'utc')
                )
            ''').update
            // 早期测试建过没有 colbert 列的表：IF NOT EXISTS 不会补列，这里显式 ALTER
            executor.setSql('ALTER TABLE llm_memory_vector ADD COLUMN IF NOT EXISTS title_colbert BYTEA').update
            executor.setSql('ALTER TABLE llm_memory_vector ADD COLUMN IF NOT EXISTS content_colbert BYTEA').update
            executor.setSql('''
                CREATE TABLE IF NOT EXISTS llm_memory_token (
                  memory_id BIGINT NOT NULL,
                  user_id   BIGINT NOT NULL,
                  namespace VARCHAR(32) NOT NULL,
                  field     CHAR(1) NOT NULL,
                  token     BIGINT NOT NULL,
                  weight    DOUBLE PRECISION NOT NULL,
                  PRIMARY KEY (memory_id, field, token)
                )
            ''').update
            Some(PostgresMemoryRepository())
        }catch(e: Exception){
            // 没有 PG 环境时显式跳过，并打印原因（CI 日志里能看到，而不是静默通过）
            println("SKIP PostgresMemoryRepositoryTest: ${e.message}")
            None
        }
    }

    @TestCase
    func testAddGetListRemove(): Unit {
        match(repository()){
            case Some(repo) =>
                let store = SqlMemoryStore(repo, Fixed1024Embedder())
                let record = store.add(MemoryWrite(9001, 'ws-9', '标题', '正文', 'note'))
                @Expect(store.get(9001, record.id).isSome(), true)
                @Expect(store.list(9001, 'ws-9', 0, 10).size >= 1, true)
                @Expect(store.remove(9001, record.id), true)
                @Expect(store.get(9001, record.id).isNone(), true)
            case None => ()
        }
    }

    private func metaStore(): ?PostgresMetaStore {
        try{
            registerPostgresDriver()
            let driver = DriverManager.getDriver('postgres').getOrThrow()
            ORM.register(driver, URL, default: true)
            let executor = ORM.executor('postgres')
            executor.setSql('''
                CREATE TABLE IF NOT EXISTS llm_conf (
                  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                  provider VARCHAR(64) NOT NULL DEFAULT '',
                  llm_name VARCHAR(128) NOT NULL DEFAULT '',
                  actual_llm_name VARCHAR(128) NOT NULL DEFAULT '',
                  llm_url VARCHAR(512) NOT NULL DEFAULT '',
                  auth VARCHAR(512) NOT NULL DEFAULT '',
                  temperature DOUBLE PRECISION NOT NULL DEFAULT -1,
                  always_thinking BOOLEAN NOT NULL DEFAULT FALSE,
                  conf TEXT,
                  enabled BOOLEAN NOT NULL DEFAULT TRUE,
                  weight BIGINT NOT NULL DEFAULT 1
                )
            ''').update
            executor.setSql('''
                CREATE TABLE IF NOT EXISTS llm_character (
                  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                  user_id BIGINT NOT NULL,
                  character_key VARCHAR(32) NOT NULL DEFAULT 'default',
                  prompts TEXT,
                  update_time TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'utc'),
                  CONSTRAINT uk_character_user UNIQUE (user_id)
                )
            ''').update
            executor.setSql('''
                CREATE TABLE IF NOT EXISTS skills (
                  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                  agent_id BIGINT NOT NULL DEFAULT 0,
                  accepted_event VARCHAR(64) NOT NULL DEFAULT '',
                  returned_event VARCHAR(64) NOT NULL DEFAULT '',
                  title VARCHAR(256) NOT NULL DEFAULT '',
                  metadata TEXT,
                  details TEXT,
                  functions TEXT,
                  version INT NOT NULL DEFAULT 1,
                  skill_type VARCHAR(32) NOT NULL DEFAULT ''
                )
            ''').update
            executor.setSql('''
                CREATE TABLE IF NOT EXISTS llm_prompt (
                  name VARCHAR(128) NOT NULL,
                  version INT NOT NULL,
                  content TEXT NOT NULL,
                  update_time TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'utc'),
                  PRIMARY KEY (name, version)
                )
            ''').update
            Some(PostgresMetaStore())
        }catch(e: Exception){
            println("SKIP PostgresMetaStoreTest: ${e.message}")
            None
        }
    }

    @TestCase
    func testPostgresCharacterOverwriteAndReset(): Unit {
        match(metaStore()){
            case Some(meta) =>
                meta.characters.set(Character(5001, 'rigorous', '严谨'))
                meta.characters.set(Character(5001, 'whimsical', '鬼灵精怪'))
                @Expect(meta.characters.get(5001).getOrThrow().characterKey, 'whimsical')
                meta.characters.reset(5001)
                @Expect(meta.characters.get(5001).isNone(), true)
            case None => ()
        }
    }

    @TestCase
    func testPostgresCharacterRejectsUnknownKey(): Unit {
        match(metaStore()){
            case Some(meta) =>
                var thrown = false
                try{
                    meta.characters.set(Character(5002, 'not-exist', ''))
                }catch(_: IllegalArgumentException){
                    thrown = true
                }
                @Expect(thrown, true)
            case None => ()
        }
    }

    @TestCase
    func testConfCandidatesFilterDisabledAndZeroWeight(): Unit {
        match(metaStore()){
            case Some(meta) =>
                let executor = ORM.executor('postgres')
                executor.setSql('DELETE FROM llm_conf').update
                executor.setSql('''
                    INSERT INTO llm_conf (provider, llm_name, actual_llm_name, enabled, weight)
                    VALUES ('p1', 'chat-pro', 'pro', true, 10),
                           ('p2', 'chat-pro', 'pro-off', false, 10),
                           ('p3', 'chat-pro', 'pro-zero', true, 0)
                ''').update
                let candidates = meta.confs.candidates('chat-pro')
                @Expect(candidates.size, 1)
                @Expect(candidates[0].actualLlmName, 'pro')
            case None => ()
        }
    }

    @TestCase
    func testPostgresSkillAndPrompt(): Unit {
        match(metaStore()){
            case Some(meta) =>
                meta.skills.upsert(Skill(1, 'pg-skill', '步骤', 'tool:webSearch'))
                @Expect(meta.skills.get(1).getOrThrow().version, 1)
                @Expect(meta.skills.list().size >= 1, true)

                meta.prompts.put(PromptEntry('pg.prompt', 1, 'v1'))
                meta.prompts.put(PromptEntry('pg.prompt', 2, 'v2'))
                @Expect(meta.prompts.latest('pg.prompt').getOrThrow().content, 'v2')
                @Expect(meta.prompts.get('pg.prompt', 1).getOrThrow().content, 'v1')
                @Expect(meta.prompts.get('not-exist', 1).isNone(), true)
            case None => ()
        }
    }

    @TestCase
    func testColbertRoundTrip(): Unit {
        match(repository()){
            case Some(repo) =>
                let store = SqlMemoryStore(repo, Fixed1024Embedder())
                let record = store.add(MemoryWrite(9003, 'ws-9', 'colbert', '二进制', 'note'))
                let vectors = repo.colbert(record.id)
                @Expect(vectors.isSome(), true)
                @Expect(vectors.getOrThrow().title.size, 1)
            case None => ()
        }
    }

    @TestCase
    func testDenseSearchReturnsAddedRecord(): Unit {
        match(repository()){
            case Some(repo) =>
                let store = SqlMemoryStore(repo, Fixed1024Embedder())
                let record = store.add(MemoryWrite(9002, 'ws-9', '仓颉记忆', '仓颉正文', 'note'))
                let hits = store.search(MemoryQuery(9002, ['ws-9'], [], '仓颉', topK: 5))
                @Expect(hits.size >= 1, true)
                @Expect(hits[0].record.id, record.id)
            case None => ()
        }
    }
}
