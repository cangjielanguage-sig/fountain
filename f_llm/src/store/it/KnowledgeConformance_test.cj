package fountain::f_llm.store.it

import std.collection.*
import std.database.sql.*
import std.unittest.*
import std.unittest.testmacro.*

import fountain::f_orm.*
import mysql_driver.registerMysqlDriver
import postgres_driver.registerPostgresDriver

import fountain::f_llm.store.*
import fountain::f_llm.store.mysql.*
import fountain::f_llm.store.postgres.*

/** 知识文档 conformance：存取 + 切块检索（PG / MySQL / 内存）。 */
@Test
public class KnowledgeConformanceTest {
    private static let PG_URL = 'postgres://fllm_test:fllm_test@127.0.0.1:5432/fllm_test'
    private static let MY_URL = 'mysql://fllm_test:fllm_test@127.0.0.1:3306/fllm_test'

    private func postgresKnowledge(): ?PostgresKnowledgeStore {
        try{
            registerPostgresDriver()
            let driver = DriverManager.getDriver('postgres').getOrThrow()
            ORM.register(driver, PG_URL, default: true)
            let executor = ORM.executor('postgres')
            executor.setSql('DROP TABLE IF EXISTS llm_document_chunk').update
            executor.setSql('DROP TABLE IF EXISTS llm_document').update
            executor.setSql('''
                CREATE TABLE llm_document (
                  doc_id VARCHAR(128) PRIMARY KEY,
                  title VARCHAR(256) NOT NULL DEFAULT '',
                  content TEXT NOT NULL,
                  update_time TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'utc')
                )
            ''').update
            executor.setSql('''
                CREATE TABLE llm_document_chunk (
                  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                  doc_id VARCHAR(128) NOT NULL,
                  seq INT NOT NULL,
                  content TEXT NOT NULL,
                  content_vec vector(1024),
                  update_time TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'utc')
                )
            ''').update
            Some(PostgresKnowledgeStore())
        }catch(e: Exception){
            println("SKIP KnowledgeConformanceTest(PG): ${e.message}")
            None
        }
    }

    private func mysqlKnowledge(): ?MySqlKnowledgeStore {
        try{
            registerMysqlDriver()
            let driver = DriverManager.getDriver('mysql').getOrThrow()
            ORM.register(driver, MY_URL, default: true)
            let executor = ORM.executor('mysql')
            executor.setSql('DROP TABLE IF EXISTS llm_document_chunk').update
            executor.setSql('DROP TABLE IF EXISTS llm_document').update
            executor.setSql('''
                CREATE TABLE llm_document (
                  doc_id VARCHAR(128) PRIMARY KEY,
                  title VARCHAR(256) NOT NULL DEFAULT '',
                  content LONGTEXT NOT NULL,
                  update_time DATETIME NOT NULL DEFAULT (UTC_TIMESTAMP())
                )
            ''').update
            executor.setSql('''
                CREATE TABLE llm_document_chunk (
                  id BIGINT AUTO_INCREMENT PRIMARY KEY,
                  doc_id VARCHAR(128) NOT NULL,
                  seq INT NOT NULL,
                  content LONGTEXT NOT NULL,
                  content_vec MYVECTOR(type=HNSW,dim=1024,size=1000,dist=COSINE,m=16,ef=100),
                  update_time DATETIME NOT NULL DEFAULT (UTC_TIMESTAMP()),
                  KEY idx_llm_document_chunk_doc (doc_id)
                )
            ''').update
            Some(MySqlKnowledgeStore())
        }catch(e: Exception){
            println("SKIP KnowledgeConformanceTest(MySQL): ${e.message}")
            None
        }
    }

    /** 三种实现共用的断言：覆盖写、删除、检索排序 */
    private func assertSearch(store: KnowledgeStore): Unit {
        store.upsert(KnowledgeDoc('k-a', 'A', '检索 检索 检索'))
        store.upsert(KnowledgeDoc('k-b', 'B', '只有一次检索'))
        store.upsert(KnowledgeDoc('k-c', 'C', '完全无关'))

        let hits = store.search(KnowledgeQuery('检索', limit: 5))
        @Expect(hits.size, 2)
        @Expect(hits[0].docId, 'k-a')
        @Expect(hits[0].score > hits[1].score, true)
        @Expect(hits[0].content.contains('检索'), true)

        let scoped = store.search(KnowledgeQuery('检索', limit: 5, docIds: ArrayList<String>(['k-b'])))
        @Expect(scoped.size, 1)
        @Expect(scoped[0].docId, 'k-b')

        @Expect(store.remove('k-a'), true)
        let after = store.search(KnowledgeQuery('检索', limit: 5))
        @Expect(after.size, 1)
        @Expect(after[0].docId, 'k-b')
    }

    @TestCase
    func testInMemoryUpsertAndSearch(): Unit {
        // 直接建词面版知识库：`InMemoryContentStore().knowledge` 会看全局 Embedder bean，
        // 并行跑测试时可能被别的类切成语义检索，导致命中条数不确定
        let store = InMemoryKnowledgeStore()
        store.upsert(KnowledgeDoc('m-1', 't1', '正文1'))
        @Expect(store.get('m-1').getOrThrow().content, '正文1')
        assertSearch(store)
    }

    @TestCase
    func testPostgresUpsertAndSearch(): Unit {
        match(postgresKnowledge()){
            case Some(store) =>
                store.upsert(KnowledgeDoc('doc-1', '标题1', '正文1'))
                store.upsert(KnowledgeDoc('doc-1', '标题2', '正文2'))
                @Expect(store.get('doc-1').getOrThrow().title, '标题2')
                assertSearch(store)
            case None => ()
        }
    }

    @TestCase
    func testMySqlUpsertAndSearch(): Unit {
        match(mysqlKnowledge()){
            case Some(store) =>
                store.upsert(KnowledgeDoc('doc-1', '标题1', '正文1'))
                store.upsert(KnowledgeDoc('doc-1', '标题2', '正文2'))
                @Expect(store.get('doc-1').getOrThrow().title, '标题2')
                assertSearch(store)
            case None => ()
        }
    }

    /** 词面候选分页：每页 1 条时必须翻页，不能只取首屏 */
    @TestCase
    func testPostgresLexicalPaging(): Unit {
        match(postgresKnowledge()){
            case Some(_) =>
                let paged = PostgresKnowledgeStore(pageSize: 1, maxCandidates: 10)
                paged.upsert(KnowledgeDoc('p-1', 't', '分页词 甲'))
                paged.upsert(KnowledgeDoc('p-2', 't', '分页词 乙'))
                @Expect(paged.search(KnowledgeQuery('分页词', limit: 5)).size, 2)
            case None => ()
        }
    }

    @TestCase
    func testMySqlLexicalPaging(): Unit {
        match(mysqlKnowledge()){
            case Some(_) =>
                let paged = MySqlKnowledgeStore(pageSize: 1, maxCandidates: 10)
                paged.upsert(KnowledgeDoc('p-1', 't', '分页词 甲'))
                paged.upsert(KnowledgeDoc('p-2', 't', '分页词 乙'))
                @Expect(paged.search(KnowledgeQuery('分页词', limit: 5)).size, 2)
            case None => ()
        }
    }

    /** P0.2：MySQL 的 MyVector 通道同样能在无词面命中时召回 */
    @TestCase
    func testMySqlSemanticRecallWithoutLexicalMatch(): Unit {
        match(mysqlKnowledge()){
            case Some(_) =>
                let semantic = MySqlKnowledgeStore(FixedEmbedder())
                semantic.upsert(KnowledgeDoc('v-my', '语义', '完全不含查询词'))
                ORM.executor('mysql').setSql(
                    "CALL mysql.myvector_index_build('fllm_test.llm_document_chunk.content_vec','id')"
                ).mapList()

                let lexicalOnly = MySqlKnowledgeStore()
                @Expect(lexicalOnly.search(KnowledgeQuery('另一个词', limit: 5)).size, 0)

                let hits = semantic.search(KnowledgeQuery('另一个词', limit: 5))
                @Expect(hits.size, 1)
                @Expect(hits[0].docId, 'v-my')
                @Expect(hits[0].score > 0.5f64, true)
            case None => ()
        }
    }

    /** P0.2：有 Embedder 时，即使词面完全不命中也能靠向量召回 */
    @TestCase
    func testPostgresSemanticRecallWithoutLexicalMatch(): Unit {
        match(postgresKnowledge()){
            case Some(_) =>
                let semantic = PostgresKnowledgeStore(FixedEmbedder())
                semantic.upsert(KnowledgeDoc('v-1', '语义', '完全不含查询词'))

                let lexicalOnly = PostgresKnowledgeStore()
                @Expect(lexicalOnly.search(KnowledgeQuery('另一个词', limit: 5)).size, 0)

                let hits = semantic.search(KnowledgeQuery('另一个词', limit: 5))
                @Expect(hits.size, 1)
                @Expect(hits[0].docId, 'v-1')
                @Expect(hits[0].score > 0.5f64, true)
            case None => ()
        }
    }
}

/** 固定返回 [1,0,0...]：让任意查询与任意块都相似，用来验证向量通道生效 */
class FixedEmbedder <: Embedder {
    public func embed(text: String): Array<Float64> {
        let vector = Array<Float64>(1024, repeat: 0.0f64)
        vector[0] = 1.0f64
        vector
    }

    public func embedColbert(text: String): Array<Array<Float64>> {
        Array<Array<Float64>>()
    }

    public func tokenize(text: String): HashMap<Int64, Float64> {
        HashMap<Int64, Float64>()
    }
}
