package fountain::f_llm.store.it

import std.collection.*
import std.database.sql.*
import std.unittest.*
import std.unittest.testmacro.*

import fountain::f_orm.*
import mysql_driver.registerMysqlDriver
import postgres_driver.registerPostgresDriver

import fountain::f_llm.model.po.TokenUsage
import fountain::f_llm.store.mysql.*
import fountain::f_llm.store.postgres.*

/** P1：Token 用量落库（PG / MySQL 各一条）。 */
@Test
public class TokenUsageSaverTest {
    private static let PG_URL = 'postgres://fllm_test:fllm_test@127.0.0.1:5432/fllm_test'
    private static let MY_URL = 'mysql://fllm_test:fllm_test@127.0.0.1:3306/fllm_test'

    private func usage(): TokenUsage {
        let value = TokenUsage()
        value.llmId = 612
        value.agentId = 42
        value.session = 'sess-1'
        value.prompt = 100
        value.completion = 40
        value.total = 140
        value.cached = 10
        value.usageTime = 2026103112
        value
    }

    private static func intOf(value: ?Any): Int64 {
        match(value){
            case Some(raw) =>
                match(raw){
                    case number: Int64 => number
                    case number: Int32 => Int64(number)
                    case _ => -1
                }
            case None => -1
        }
    }

    @TestCase
    func testPostgresPersistsUsage(): Unit {
        try{
            registerPostgresDriver()
            let driver = DriverManager.getDriver('postgres').getOrThrow()
            ORM.register(driver, PG_URL, default: true)
            let executor = ORM.executor('postgres')
            executor.setSql('DROP TABLE IF EXISTS llm_token_usage').update
            executor.setSql('''
                CREATE TABLE llm_token_usage (
                  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                  llm_id BIGINT NOT NULL DEFAULT 0,
                  agent_id BIGINT NOT NULL DEFAULT 0,
                  session VARCHAR(128) NOT NULL DEFAULT '',
                  prompt_tokens BIGINT NOT NULL DEFAULT 0,
                  completion_tokens BIGINT NOT NULL DEFAULT 0,
                  total_tokens BIGINT NOT NULL DEFAULT 0,
                  cached_tokens BIGINT NOT NULL DEFAULT 0,
                  usage_time BIGINT NOT NULL DEFAULT 0
                )
            ''').update

            PostgresTokenUsageSaver().saveTokenUsage(usage())

            let row = executor.setSql('''
                SELECT llm_id, agent_id, session, prompt_tokens, completion_tokens,
                       total_tokens, cached_tokens, usage_time
                FROM llm_token_usage
            ''').firstToMap()
            @Expect(intOf(row.get('llm_id')), 612)
            @Expect(intOf(row.get('agent_id')), 42)
            @Expect(intOf(row.get('prompt_tokens')), 100)
            @Expect(intOf(row.get('total_tokens')), 140)
            @Expect(intOf(row.get('usage_time')), 2026103112)
        }catch(e: Exception){
            println("SKIP TokenUsageSaverTest(PG): ${e.message}")
        }
    }

    @TestCase
    func testMySqlPersistsUsage(): Unit {
        try{
            registerMysqlDriver()
            let driver = DriverManager.getDriver('mysql').getOrThrow()
            ORM.register(driver, MY_URL, default: true)
            let executor = ORM.executor('mysql')
            executor.setSql('DROP TABLE IF EXISTS llm_token_usage').update
            executor.setSql('''
                CREATE TABLE llm_token_usage (
                  id BIGINT AUTO_INCREMENT PRIMARY KEY,
                  llm_id BIGINT NOT NULL DEFAULT 0,
                  agent_id BIGINT NOT NULL DEFAULT 0,
                  session VARCHAR(128) NOT NULL DEFAULT '',
                  prompt_tokens BIGINT NOT NULL DEFAULT 0,
                  completion_tokens BIGINT NOT NULL DEFAULT 0,
                  total_tokens BIGINT NOT NULL DEFAULT 0,
                  cached_tokens BIGINT NOT NULL DEFAULT 0,
                  usage_time BIGINT NOT NULL DEFAULT 0,
                  KEY idx_usage_agent (agent_id, usage_time)
                )
            ''').update

            MySqlTokenUsageSaver().saveTokenUsage(usage())

            let row = executor.setSql('''
                SELECT llm_id, prompt_tokens, total_tokens FROM llm_token_usage
            ''').firstToMap()
            @Expect(intOf(row.get('llm_id')), 612)
            @Expect(intOf(row.get('prompt_tokens')), 100)
            @Expect(intOf(row.get('total_tokens')), 140)
        }catch(e: Exception){
            println("SKIP TokenUsageSaverTest(MySQL): ${e.message}")
        }
    }
}
