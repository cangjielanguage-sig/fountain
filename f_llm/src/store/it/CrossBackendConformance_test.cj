package fountain::f_llm.store.it

import fountain::f_llm.store.*
import fountain::f_llm.store.postgres.*
import fountain::f_llm.store.mysql.*

import std.collection.*
import std.database.sql.*
import std.unittest.*
import std.unittest.testmacro.*

import fountain::f_orm.*

import fountain::f_llm.store.postgres.*
import fountain::f_llm.store.mysql.*
import mysql_driver.registerMysqlDriver
import postgres_driver.registerPostgresDriver

/**
 * 4.5：同一数据集在 PG 与 MySQL 上检索，topK 的标题集合一致（浮点/索引差异不比较顺序）。
 */
@Test
public class CrossBackendConformanceTest {
    private static let PG_URL = 'postgres://fllm_test:fllm_test@127.0.0.1:5432/fllm_test'
    private static let MY_URL = 'mysql://fllm_test:fllm_test@127.0.0.1:3306/fllm_test'

    private func vector(seed: Float64): Array<Float64> {
        let values = Array<Float64>(1024, repeat: 0.0f64)
        for(index in 0..1024){
            values[index] = seed + Float64(index) * 0.0001f64
        }
        values
    }

    private func seed(repo: MemoryRepository): Unit {
        repo.upsert(MemoryWrite(1, 'global', 'alpha', 'a', 'note'), vector(0.01f64), vector(0.01f64))
        repo.upsert(MemoryWrite(1, 'global', 'beta', 'b', 'note'), vector(0.50f64), vector(0.50f64))
        repo.upsert(MemoryWrite(1, 'global', 'gamma', 'c', 'note'), vector(0.90f64), vector(0.90f64))
    }

    private func titles(hits: ArrayList<MemoryHit>): String {
        let names = ArrayList<String>()
        for(hit in hits){
            names.add(hit.record.title)
        }
        names.sort()
        var text = ''
        for(name in names){
            text += name + ','
        }
        text
    }

    @TestCase
    func testMySqlDdlIsIdempotent(): Unit {
        registerMysqlDriver()
        ORM.register(DriverManager.getDriver('mysql').getOrThrow(), MY_URL, default: true)
        let executor = ORM.executor('mysql')
        let ddl = '''
            CREATE TABLE IF NOT EXISTS ddl_probe (
              id BIGINT AUTO_INCREMENT PRIMARY KEY,
              note VARCHAR(32),
              UNIQUE KEY uk_ddl_probe (note)
            )
        '''
        executor.setSql(ddl).update
        executor.setSql(ddl).update
        executor.setSql('DROP TABLE IF EXISTS ddl_probe').update
    }

    @TestCase
    func testTopKParityBetweenPgAndMySql(): Unit {
        // PG
        registerPostgresDriver()
        ORM.register(DriverManager.getDriver('postgres').getOrThrow(), PG_URL, default: true)
        let pg = ORM.executor('postgres')
        pg.setSql('DROP TABLE IF EXISTS llm_memory_vector').update
        pg.setSql('DROP TABLE IF EXISTS llm_memory').update
        pg.setSql('''
            CREATE TABLE llm_memory (
              id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
              user_id BIGINT NOT NULL, namespace VARCHAR(32) NOT NULL,
              title VARCHAR(128) NOT NULL, content TEXT, kind VARCHAR(32) NOT NULL DEFAULT 'note',
              save_time TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'utc'),
              update_time TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'utc'),
              CONSTRAINT uk_memory_user_ns_title UNIQUE (user_id, namespace, title)
            )
        ''').update
        pg.setSql('''
            CREATE TABLE llm_memory_vector (
              memory_id BIGINT PRIMARY KEY, model VARCHAR(64) NOT NULL DEFAULT 'bge-m3',
              title_dense vector(1024), content_dense vector(1024),
              title_colbert BYTEA, content_colbert BYTEA,
              has_sparse BOOLEAN NOT NULL DEFAULT FALSE,
              has_colbert BOOLEAN NOT NULL DEFAULT FALSE,
              update_time TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'utc')
            )
        ''').update
        let pgRepo = PostgresMemoryRepository()
        seed(pgRepo)
        let pgHits = pgRepo.searchDense(MemoryQuery(1, ['global'], [], 'q', topK: 2), vector(0.0101f64), 2)

        // MySQL
        registerMysqlDriver()
        ORM.register(DriverManager.getDriver('mysql').getOrThrow(), MY_URL, default: true)
        let my = ORM.executor('mysql')
        my.setSql('DROP TABLE IF EXISTS llm_memory_token').update
        my.setSql('DROP TABLE IF EXISTS llm_memory').update
        my.setSql('''
            CREATE TABLE llm_memory (
              id BIGINT AUTO_INCREMENT PRIMARY KEY,
              user_id BIGINT NOT NULL, namespace VARCHAR(32) NOT NULL,
              title VARCHAR(128) NOT NULL, content TEXT, kind VARCHAR(32) NOT NULL DEFAULT 'note',
              title_vec MYVECTOR(type=HNSW,dim=1024,size=1000,dist=COSINE,m=16,ef=100),
              content_vec MYVECTOR(type=HNSW,dim=1024,size=1000,dist=COSINE,m=16,ef=100),
              title_colbert LONGBLOB NULL, content_colbert LONGBLOB NULL,
              save_time DATETIME NOT NULL DEFAULT (UTC_TIMESTAMP()),
              update_time DATETIME NOT NULL DEFAULT (UTC_TIMESTAMP()),
              UNIQUE KEY uk_memory (user_id, namespace, title)
            )
        ''').update
        let myRepo = MySqlMemoryRepository(database: 'fllm_test')
        seed(myRepo)
        my.setSql("CALL mysql.myvector_index_build('fllm_test.llm_memory.title_vec','id')").mapList()
        let myHits = myRepo.searchDense(MemoryQuery(1, ['global'], [], 'q', topK: 2), vector(0.0101f64), 2)

        @Expect(pgHits.size, 2)
        @Expect(myHits.size, 2)
        @Expect(titles(pgHits), titles(myHits))
    }
}
