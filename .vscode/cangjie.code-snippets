	"for":{
		"scope": "cangjie,Cangjie,cj",
		"prefix": "for",
		"body":[
			"for($1 in $2) {",
			"    $0",
			"}"
		]
	},
	"for range":{
		"scope": "cangjie,Cangjie,cj",
		"prefix": "for.0",
		"body":[
			"for(${1:i} in ${2:0}..$3) {",
			"    $0",
			"}"
		]
	},
	"for size range":{
		"scope": "cangjie,Cangjie,cj",
		"prefix": "for.0.size",
		"body":[
			"for(${1:i} in ${2:0}..$3.size$4) {",
			"    $0",
			"}"
		]
	},
	"for closed range":{
		"scope": "cangjie,Cangjie,cj",
		"prefix": "for.0=",
		"body":[
			"for(${1:i} in ${2:0}..=$3) {",
			"    $0",
			"}"
		]
	},
	"for closed size range":{
		"scope": "cangjie,Cangjie,cj",
		"prefix": "for.0=size",
		"body":[
			"for(${1:i} in ${2:0}..=$3.size$4) {",
			"    $0",
			"}"
		]
	},
	"while i":{
		"scope": "cangjie,Cangjie,cj",
		"prefix": "while i",
		"body":[
			"var ${1|i,j,k,a,b,c|} = $2",
			"while($1 $3 $4) {",
			"    $0",
			"    $1$5",
			"}"
		]
	},
	"while i ++":{
		"scope": "cangjie,Cangjie,cj",
		"prefix": "while i++",
		"body":[
			"var ${1|i,j,k,a,b,c|} = $2",
			"while($1 $3 $4) {",
			"    $0",
			"    $1++",
			"}"
		]
	},
	"while i --":{
		"scope": "cangjie,Cangjie,cj",
		"prefix": "while i--",
		"body":[
			"var ${1|i,j,k,a,b,c|} = $2",
			"while($1 $3 $4) {",
			"    $0",
			"    $1--",
			"}"
		]
	},
	"while i.size":{
		"scope": "cangjie,Cangjie,cj",
		"prefix": "while i size",
		"body":[
			"var ${1|i,j,k,a,b,c|} = ${2:0}",
			"while($1 < $3${4:.size}) {",
			"    $0",
			"    $1${5|++, += |}${6}",
			"}"
		]
	},
	"while size":{
		"scope": "cangjie,Cangjie,cj",
		"prefix": "while size",
		"body":[
			"var ${1|i,j,k,a,b,c|} = $2${3:.size} -1 ",
			"while($1 >= ${4:0}) {",
			"    $0",
			"    $1${5|--, -= |}${6}",
			"}"
		]
	},
	"while sizevar":{
		"scope": "cangjie,Cangjie,cj",
		"prefix": "while sizevar",
		"body":[
			"var ${1|size} = $2${3:.size}",
			"var ${4|i,j,k,a,b,c|} = ${5|0}",
			"while($4 >= ${1|size}) {",
			"    $0",
			"    $4${6|--, -= |}${7}",
			"}"
		]
	},
